        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam style strictuml\nskinparam sequenceMessageAlign center\nskinparam shadowing false\nautonumber\n\nactor \&quot;Nhân viên Nhân sự\&quot; as HR\nboundary \&quot;:MH_QDKhenThuong\&quot; as UI\ncontrol \&quot;:KhenThuongController\&quot; as Ctrl\nentity \&quot;:QuyetDinhKhenThuongKyLuat\&quot; as QD\nentity \&quot;:ChiTietKhenThuongKyLuat\&quot; as CT\n\nHR -&gt; UI : yeuCauLapQDKhenThuong()\nactivate UI\nUI --&gt; HR : hienThiFormNhap()\ndeactivate UI\n\nHR -&gt; UI : nhapThongTinQuyetDinh(thongTinQD, dsDoiTuong)\nactivate UI\nUI -&gt; Ctrl : xuLyLapQuyetDinh(thongTinQD, dsDoiTuong)\nactivate Ctrl\n\nCtrl -&gt; Ctrl : kiemTraThongTinHopLe()\n\nalt Thông tin hợp lệ\n    create QD\n    Ctrl -&gt; QD : create(MaQDKTKL, LoaiQuyetDinh, HinhThuc, NgayKy, SoTien, NoiDung, NguoiKy)\n    Ctrl -&gt; QD : lapQuyetDinh()\n    activate QD\n    QD --&gt; Ctrl : ketQuaLuuQuyetDinh\n    deactivate QD\n\n    loop Đối với mỗi đối tượng (Cá nhân NV hoặc Tập thể PB)\n        create CT\n        Ctrl -&gt; CT : create(MaCTKTKL, MaQDKTKL, MaNV, MaPB, SoTienCuThe, GhiChu)\n        Ctrl -&gt; CT : themDoiTuong()\n        activate CT\n        CT --&gt; Ctrl : ketQuaLuuChiTiet\n        deactivate CT\n    end\n\n    Ctrl --&gt; UI : thongBaoThanhCong(MaQDKTKL)\n    activate UI\n    UI --&gt; HR : hienThiQuyetDinhVaThongBao()\n    deactivate UI\n\nelse Thông tin không hợp lệ\n    Ctrl --&gt; UI : thongBaoLoi(\&quot;Dữ liệu nhập không hợp lệ\&quot;)\n    activate UI\n    UI --&gt; HR : hienThiThongBaoLoi()\n    deactivate UI\nend\n\ndeactivate Ctrl\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="t6xbK539QQcwfpUID_jz-189">
