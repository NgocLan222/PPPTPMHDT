        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam style strictuml\nskinparam sequenceMessageAlign center\nskinparam shadowing false\nautonumber\n\nactor \&quot;NV Kinh doanh\&quot; as NV\nboundary \&quot;:MH_GiaHan\&quot; as UI\ncontrol \&quot;:GiaHanService\&quot; as Ctrl\nentity \&quot;:HopDongThue\&quot; as HD\nentity \&quot;:HoaDon\&quot; as HoaDon\nentity \&quot;:PhieuGiaHan\&quot; as PGH\nentity \&quot;:Phong\&quot; as P\n\nNV -&gt; UI : moFormGiaHan()\nactivate UI\nUI --&gt; NV : hienThiFormNhap()\ndeactivate UI\n\nNV -&gt; UI : xacNhanGiaHan(MaHD, MaPhong, ThoiGianGiaHan)\nactivate UI\nUI -&gt; Ctrl : xuLyGiaHan(MaHD, MaPhong, ThoiGianGiaHan)\nactivate Ctrl\n\nCtrl -&gt; HD : kiemTraThoiGianHopLe(ThoiGianGiaHan)\nactivate HD\nHD --&gt; Ctrl : ketQuaHopLe (&lt;= 1/2 thoi han goc)\ndeactivate HD\n\nCtrl -&gt; HoaDon : kiemTraCongNo(MaHD, MaPhong)\nactivate HoaDon\nHoaDon --&gt; Ctrl : ketQuaNoPhi (ConNo / DaThanhToanHet)\ndeactivate HoaDon\n\nalt ThoiGianGiaHan &lt;= 1/2 ThoiHanThue AND KhongNoPhi\n    create PGH\n    Ctrl -&gt; PGH : create(MaPGH, NgayLap, ThoiGianGiaHan, NgayKetThucMoi, MaHD, MaPhong)\n    Ctrl -&gt; PGH : lapPhieuGiaHan()\n    activate PGH\n    PGH --&gt; Ctrl : ketQuaLuuPhieu\n    deactivate PGH\n\n    Ctrl -&gt; P : doiTrangThai()\n    activate P\n    P --&gt; Ctrl : xacNhanCapNhat\n    deactivate P\n\n    Ctrl --&gt; UI : thongBaoThanhCong(MaPGH)\n    activate UI\n    UI --&gt; NV : hienThiThanhCongVaInPhieu()\n    deactivate UI\n\nelse Vi pham thoi gian (&gt; 1/2) HOẶC Con no tien phong/dich vu\n    Ctrl --&gt; UI : thongBaoLoi(LyDoTuChoi)\n    activate UI\n    UI --&gt; NV : hienThiCanhBaoLoi(LyDo)\n    deactivate UI\nend\n\ndeactivate Ctrl\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7EVib9KMUI449ODl6IS0-130">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
