        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam style strictuml\nskinparam sequenceMessageAlign center\n\nparticipant \&quot;Khách Hàng\&quot; as KH\nparticipant \&quot;FrmMuaSam\&quot; as GUI_MuaSam\nparticipant \&quot;FrmDangNhap\&quot; as GUI_DangNhap\nparticipant \&quot;FrmDatHang\&quot; as GUI_DatHang\nparticipant \&quot;DatHangService\&quot; as Service\nparticipant \&quot;CSDL\&quot; as DB\nparticipant \&quot;FrmThanhToan\&quot; as GUI_ThanhToan\n\nKH -&gt; GUI_MuaSam: Chọn đặt hàng (Tính tiền)\nactivate GUI_MuaSam\n\nGUI_MuaSam -&gt; GUI_MuaSam: Kiểm tra đăng nhập\nalt Chưa đăng nhập\n    GUI_MuaSam -&gt; GUI_DangNhap: Yêu cầu đăng nhập\n    activate GUI_DangNhap\n    KH -&gt; GUI_DangNhap: Nhập thông tin tài khoản\n    GUI_DangNhap -&gt; DB: Xác thực thông tin\n    activate DB\n    DB --&gt; GUI_DangNhap: Hợp lệ\n    deactivate DB\n    GUI_DangNhap --&gt; GUI_MuaSam: Đăng nhập thành công\n    deactivate GUI_DangNhap\nend\n\nGUI_MuaSam -&gt; GUI_DatHang: Hiển thị biểu mẫu đặt hàng\ndeactivate GUI_MuaSam\nactivate GUI_DatHang\n\nKH -&gt; GUI_DatHang: Chọn loại phiếu &amp; nhập người nhận\nGUI_DatHang -&gt; Service: Tính phí giao hàng &amp; kiểm tra freeship\nactivate Service\nService --&gt; GUI_DatHang: Trả về cước phí &amp; tổng tiền\ndeactivate Service\n\nKH -&gt; GUI_DatHang: Xác nhận đặt hàng\nGUI_DatHang -&gt; Service: Lập phiếu đặt hàng\nactivate Service\nService -&gt; DB: Lưu thông tin phiếu đặt (Chờ thanh toán)\nactivate DB\nDB --&gt; Service: Thành công (Mã phiếu đặt)\ndeactivate DB\nService --&gt; GUI_DatHang: Mã phiếu đặt\ndeactivate Service\n\nGUI_DatHang -&gt; GUI_ThanhToan: Chuyển sang giao diện thanh toán\nactivate GUI_ThanhToan\ndeactivate GUI_DatHang\nGUI_ThanhToan --&gt; KH: Hiển thị thông tin thanh toán\ndeactivate GUI_ThanhToan\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zxO1dQOrbGEQnIHdrYQz-201">
